{
  "manifest_version": 3,
  "name": "PisoCheck \u2014 Idealista scam check",
  "version": "0.1.0",
  "description": "Instant scam and risk probabilities for Idealista rental listings in Barcelona, powered by Jev.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*",
    "https://pisocheck-proxy.hussein-saad-hasan.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "PisoCheck",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.idealista.com/*",
        "https://www.idealista.it/*",
        "https://www.idealista.pt/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}